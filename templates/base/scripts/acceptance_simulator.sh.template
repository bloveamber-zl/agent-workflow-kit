#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

ACCEPTANCE_COMMAND="${ACCEPTANCE_COMMAND:-{{START_COMMAND}}}"
ACCEPTANCE_DEVICE="${ACCEPTANCE_DEVICE:-${FLUTTER_DEVICE:-}}"
ACCEPTANCE_PLATFORM="${ACCEPTANCE_PLATFORM:-}"
ACCEPTANCE_LAUNCH_CONFIG="${ACCEPTANCE_LAUNCH_CONFIG:-}"
ACCEPTANCE_DART_DEFINE_FILE="${ACCEPTANCE_DART_DEFINE_FILE:-}"
ACCEPTANCE_FLAVOR="${ACCEPTANCE_FLAVOR:-}"
ACCEPTANCE_EXTRA_ARGS="${ACCEPTANCE_EXTRA_ARGS:-}"
ACCEPTANCE_TIMEOUT_SECONDS="${ACCEPTANCE_TIMEOUT_SECONDS:-600}"
ACCEPTANCE_KEEP_RUNNING="${ACCEPTANCE_KEEP_RUNNING:-0}"
ACCEPTANCE_DRY_RUN="${ACCEPTANCE_DRY_RUN:-0}"
ACCEPTANCE_SCENARIO="${ACCEPTANCE_SCENARIO:-unspecified}"
ACCEPTANCE_EXPECTED_PATH="${ACCEPTANCE_EXPECTED_PATH:-未指定}"

ARTIFACT_DIR="$ROOT_DIR/.dart_tool/acceptance"
RUN_ID="$(date +%Y%m%d-%H%M%S)"
RUN_DIR="$ARTIFACT_DIR/$RUN_ID"
LOG_FILE="$RUN_DIR/acceptance.log"
SUMMARY_FILE="$RUN_DIR/summary.md"
CHECKLIST_FILE="$RUN_DIR/manual-checklist.md"
SCREENSHOT_FILE="$RUN_DIR/startup.png"
EVIDENCE_FILE="$RUN_DIR/evidence.json"

require_bin() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "缺少命令: $1" >&2
    exit 1
  fi
}

print_cmd() {
  printf '    %s\n' "$*"
}

find_flutter_ios_simulator() {
  if ! command -v flutter >/dev/null 2>&1; then
    return 0
  fi

  local devices line
  devices="$(flutter devices 2>/dev/null || true)"
  line="$(printf '%s\n' "$devices" | grep '(simulator)' | grep -E '[[:space:]]ios[[:space:]]' | head -n 1 || true)"

  if [ -n "$line" ]; then
    printf '%s\n' "$line" | grep -Eo '[A-F0-9]{8}(-[A-F0-9]{4}){3}-[A-F0-9]{12}' | head -n 1 || true
  fi
}

detect_flutter_device_platform() {
  local device="$1"
  if [ -n "$ACCEPTANCE_PLATFORM" ]; then
    printf '%s\n' "$ACCEPTANCE_PLATFORM"
    return 0
  fi
  if [ -z "$device" ] || ! command -v flutter >/dev/null 2>&1; then
    return 0
  fi

  flutter devices 2>/dev/null | awk -F'•' -v id="$device" '
    index($0, id) > 0 {
      platform = $3
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", platform)
      print platform
      exit
    }
  '
}

resolve_flutter_launch_args() {
  local platform="$1"
  python3 - "$ROOT_DIR" "$platform" "$ACCEPTANCE_LAUNCH_CONFIG" "$ACCEPTANCE_DART_DEFINE_FILE" "$ACCEPTANCE_FLAVOR" "$ACCEPTANCE_EXTRA_ARGS" <<'PY'
import json
import shlex
import sys
from pathlib import Path

root, platform, launch_name, dart_define_file, flavor, extra_args = sys.argv[1:7]
root = Path(root)


def strip_json_comments(text: str) -> str:
    result = []
    in_string = False
    escape = False
    i = 0
    while i < len(text):
        ch = text[i]
        nxt = text[i + 1] if i + 1 < len(text) else ""
        if in_string:
            result.append(ch)
            if escape:
                escape = False
            elif ch == "\\":
                escape = True
            elif ch == '"':
                in_string = False
            i += 1
            continue
        if ch == '"':
            in_string = True
            result.append(ch)
            i += 1
            continue
        if ch == "/" and nxt == "/":
            while i < len(text) and text[i] not in "\r\n":
                i += 1
            continue
        if ch == "/" and nxt == "*":
            i += 2
            while i + 1 < len(text) and not (text[i] == "*" and text[i + 1] == "/"):
                i += 1
            i += 2
            continue
        result.append(ch)
        i += 1
    return "".join(result)


def load_launch_args() -> list[str]:
    launch_path = root / ".vscode" / "launch.json"
    if not launch_path.exists():
        return []
    data = json.loads(strip_json_comments(launch_path.read_text(encoding="utf-8")))
    configs = [
        item
        for item in data.get("configurations", [])
        if item.get("type") == "dart" and item.get("request") == "launch"
    ]
    if not configs:
        return []
    if launch_name:
        for item in configs:
            if item.get("name") == launch_name:
                return [str(arg) for arg in item.get("args", [])]
        return []
    lower_platform = platform.lower()
    if lower_platform.startswith("ios"):
        for item in configs:
            if "ios" in str(item.get("name", "")).lower():
                return [str(arg) for arg in item.get("args", [])]
        for item in configs:
            args = [str(arg) for arg in item.get("args", [])]
            if "--flavor" not in args:
                return args
    if lower_platform.startswith("android"):
        for item in configs:
            if "android" in str(item.get("name", "")).lower():
                return [str(arg) for arg in item.get("args", [])]
        for item in configs:
            args = [str(arg) for arg in item.get("args", [])]
            if "--flavor" in args:
                return args
        for item in configs:
            if "ios" not in str(item.get("name", "")).lower():
                return [str(arg) for arg in item.get("args", [])]
    return [str(arg) for arg in configs[0].get("args", [])]


args = load_launch_args()
custom_config = root / "define_config" / ".custom.json"
if dart_define_file:
    if "--dart-define-from-file" not in args:
        args.extend(["--dart-define-from-file", dart_define_file])
elif custom_config.exists() and "--dart-define-from-file" not in args:
    args.extend(["--dart-define-from-file", "define_config/.custom.json"])

if flavor and "--flavor" not in args:
    args.extend(["--flavor", flavor])

if extra_args:
    args.extend(shlex.split(extra_args))

if args:
    print(shlex.join(args))
PY
}

write_manual_checklist() {
  cat >"$CHECKLIST_FILE" <<EOF
# 本地/模拟器手动验收清单

- 时间：$RUN_ID
- 项目：{{PROJECT_NAME}}
- 技术栈：{{STACK_NAME}}
- 命令：$ACCEPTANCE_COMMAND
- 设备：${ACCEPTANCE_DEVICE:-未指定}
- 启动配置：${ACCEPTANCE_LAUNCH_CONFIG:-自动}
- 平台：${ACCEPTANCE_PLATFORM:-自动}
- 场景：$ACCEPTANCE_SCENARIO
- 预期路径：$ACCEPTANCE_EXPECTED_PATH
- 日志：$LOG_FILE
- 启动截图：$SCREENSHOT_FILE

## 检查项

- [ ] 应用或服务已启动，没有停留在崩溃页、错误页或不可交互状态。
- [ ] 按预期路径进入目标页面或功能：$ACCEPTANCE_EXPECTED_PATH
- [ ] 目标展示、交互、异常态符合需求描述。
- [ ] 关键日志无新增 crash、未处理异常、平台异常或接口阻塞。
- [ ] 如涉及权限、相册、文件选择、录音、支付或外部系统，已实际走过对应路径或记录无法验证的 blocker。

## 结果

- 验收人：
- 结论：通过 / 不通过
- 备注：
EOF
}

write_evidence() {
  local status="$1"
  local exit_code="$2"
  python3 - "$EVIDENCE_FILE" "$status" "$exit_code" "$ACCEPTANCE_SCENARIO" "$ACCEPTANCE_EXPECTED_PATH" "$RUN_CMD" "${ACCEPTANCE_DEVICE:-}" "$LOG_FILE" "$SCREENSHOT_FILE" "$CHECKLIST_FILE" "$SUMMARY_FILE" <<'PY'
import json
import sys

(
    path,
    status,
    exit_code,
    scenario,
    expected_path,
    command,
    device,
    log_file,
    screenshot_file,
    checklist_file,
    summary_file,
) = sys.argv[1:]

with open(path, "w", encoding="utf-8") as f:
    json.dump(
        {
            "kind": "acceptance",
            "status": status,
            "exit_code": int(exit_code),
            "scenario": scenario,
            "expected_path": expected_path,
            "command": command,
            "device": device or None,
            "log_file": log_file,
            "screenshot_file": screenshot_file,
            "checklist_file": checklist_file,
            "summary_file": summary_file,
        },
        f,
        ensure_ascii=False,
        indent=2,
    )
    f.write("\n")
PY
}

write_summary() {
  local status="$1"
  cat >"$SUMMARY_FILE" <<EOF
# 本地/模拟器验收摘要

- 状态：$status
- 项目：{{PROJECT_NAME}}
- 技术栈：{{STACK_NAME}}
- 场景：$ACCEPTANCE_SCENARIO
- 预期路径：$ACCEPTANCE_EXPECTED_PATH
- 命令：\`$RUN_CMD\`
- 设备：${ACCEPTANCE_DEVICE:-未指定}
- 启动配置：${ACCEPTANCE_LAUNCH_CONFIG:-自动}
- 平台：${ACCEPTANCE_PLATFORM:-自动}
- 日志：$LOG_FILE
- 截图：$SCREENSHOT_FILE
- 手动清单：$CHECKLIST_FILE
- 证据：$EVIDENCE_FILE
EOF
}

if [ ! -f "$ROOT_DIR/init.sh" ]; then
  echo "当前目录缺少 init.sh: $ROOT_DIR" >&2
  exit 1
fi

mkdir -p "$RUN_DIR"

if [ -z "$ACCEPTANCE_DEVICE" ] && [ "{{STACK_NAME}}" = "flutter" ]; then
  ACCEPTANCE_DEVICE="$(find_flutter_ios_simulator | head -n 1 || true)"
fi

RUN_CMD="$ACCEPTANCE_COMMAND"
if [ "{{STACK_NAME}}" = "flutter" ]; then
  DETECTED_PLATFORM="$(detect_flutter_device_platform "$ACCEPTANCE_DEVICE" | head -n 1 || true)"
  LAUNCH_ARGS="$(resolve_flutter_launch_args "$DETECTED_PLATFORM" | tr -d '\n')"
  if [ -n "$LAUNCH_ARGS" ] && ! printf '%s' "$RUN_CMD" | grep -q -- '--dart-define-from-file\|--flavor'; then
    RUN_CMD="$RUN_CMD $LAUNCH_ARGS"
  fi
fi
if [ -n "$ACCEPTANCE_DEVICE" ] && [ "{{STACK_NAME}}" = "flutter" ] && ! printf '%s' "$RUN_CMD" | grep -Eq '(^|[[:space:]])-d([[:space:]]|$)'; then
  RUN_CMD="$RUN_CMD -d $ACCEPTANCE_DEVICE"
fi

echo "==> 验收命令"
print_cmd "$RUN_CMD"
echo "==> 验收设备: ${ACCEPTANCE_DEVICE:-未指定}"
echo "==> 验收产物目录: $RUN_DIR"

write_manual_checklist

if [ "$ACCEPTANCE_DRY_RUN" = "1" ]; then
  write_summary "dry-run"
  write_evidence "dry-run" 0
  echo "==> dry-run：未启动应用或服务"
  echo "==> 手动验收清单: $CHECKLIST_FILE"
  echo "==> 验收证据: $EVIDENCE_FILE"
  exit 0
fi

set +e
bash -lc "$RUN_CMD" >"$LOG_FILE" 2>&1 &
RUN_PID=$!
set -e

echo "$RUN_PID" >"$RUN_DIR/acceptance.pid"

deadline=$((SECONDS + ACCEPTANCE_TIMEOUT_SECONDS))
started=0

while kill -0 "$RUN_PID" >/dev/null 2>&1; do
  if grep -Eq 'Flutter run key commands|To hot reload changes|A Dart VM Service|Local:|localhost|ready|Ready|started|Started|listening|Listening|compiled|Compiled' "$LOG_FILE"; then
    started=1
    break
  fi

  if grep -Eq 'Error launching application|Failed to build|Could not build|No supported devices|Unhandled exception|PlatformException|EADDRINUSE|address already in use' "$LOG_FILE"; then
    echo "==> 验收启动失败，日志尾部:"
    tail -n 80 "$LOG_FILE" || true
    kill "$RUN_PID" >/dev/null 2>&1 || true
    wait "$RUN_PID" >/dev/null 2>&1 || true
    write_summary "failed"
    write_evidence "failed" 1
    exit 1
  fi

  if [ "$SECONDS" -ge "$deadline" ]; then
    echo "==> 启动等待超时: ${ACCEPTANCE_TIMEOUT_SECONDS}s"
    tail -n 80 "$LOG_FILE" || true
    kill "$RUN_PID" >/dev/null 2>&1 || true
    wait "$RUN_PID" >/dev/null 2>&1 || true
    write_summary "timeout"
    write_evidence "timeout" 1
    exit 1
  fi

  sleep 2
done

if [ "$started" != "1" ]; then
  echo "==> 验收命令提前退出或未输出可识别启动信号，日志尾部:"
  tail -n 80 "$LOG_FILE" || true
  write_summary "failed"
  write_evidence "failed" 1
  exit 1
fi

if command -v xcrun >/dev/null 2>&1 && [ -n "$ACCEPTANCE_DEVICE" ]; then
  xcrun simctl io "$ACCEPTANCE_DEVICE" screenshot "$SCREENSHOT_FILE" >/dev/null 2>&1 || true
fi

write_summary "started"
write_evidence "started" 0

echo "==> 应用或服务已启动，验收摘要: $SUMMARY_FILE"
echo "==> 手动验收清单: $CHECKLIST_FILE"
echo "==> 验收证据: $EVIDENCE_FILE"

if [ "$ACCEPTANCE_KEEP_RUNNING" = "1" ]; then
  echo "==> 保持验收命令运行中，按 Ctrl-C 结束。"
  wait "$RUN_PID"
else
  echo "==> 结束验收命令。若要保留运行用于手动点测，请设置 ACCEPTANCE_KEEP_RUNNING=1。"
  kill "$RUN_PID" >/dev/null 2>&1 || true
  wait "$RUN_PID" >/dev/null 2>&1 || true
fi
