#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

PATROL_TARGET="${PATROL_TARGET:-}"
PATROL_SCENARIO="${PATROL_SCENARIO:-unspecified}"
PATROL_DEVICE="${PATROL_DEVICE:-${FLUTTER_DEVICE:-}}"
PATROL_DART_DEFINE_FILE="${PATROL_DART_DEFINE_FILE:-}"
PATROL_FLAVOR="${PATROL_FLAVOR:-}"
PATROL_EXTRA_ARGS="${PATROL_EXTRA_ARGS:-}"
PATROL_DRY_RUN="${PATROL_DRY_RUN:-0}"
ARTIFACT_DIR="$ROOT_DIR/.dart_tool/acceptance"
RUN_ID="$(date +%Y%m%d-%H%M%S)-patrol-$$"
RUN_DIR="$ARTIFACT_DIR/$RUN_ID"
LOG_FILE="$RUN_DIR/patrol.log"
SUMMARY_FILE="$RUN_DIR/summary.md"
EVIDENCE_FILE="$RUN_DIR/evidence.json"

mkdir -p "$RUN_DIR"

cmd=(patrol test)
if [ -n "$PATROL_TARGET" ]; then
  cmd+=(--target "$PATROL_TARGET")
fi
if [ -n "$PATROL_DART_DEFINE_FILE" ]; then
  cmd+=(--dart-define-from-file "$PATROL_DART_DEFINE_FILE")
fi
if [ -n "$PATROL_FLAVOR" ]; then
  cmd+=(--flavor "$PATROL_FLAVOR")
fi
if [ -n "$PATROL_DEVICE" ]; then
  cmd+=(-d "$PATROL_DEVICE")
fi
if [ -n "$PATROL_EXTRA_ARGS" ]; then
  # shellcheck disable=SC2206
  extra_args=($PATROL_EXTRA_ARGS)
  cmd+=("${extra_args[@]}")
fi

echo "==> Patrol 验收命令"
printf '    %q' "${cmd[@]}"
printf '\n'
echo "==> Patrol 产物目录: $RUN_DIR"

status="failed"
exit_code=0

if ! command -v patrol >/dev/null 2>&1; then
  exit_code=127
  cat >"$LOG_FILE" <<EOF
缺少命令: patrol
请先按 docs/testing/patrol.md 完成 Patrol 接入检查。
EOF
elif [ "$PATROL_DRY_RUN" = "1" ]; then
  status="dry-run"
  printf '%s\n' "dry-run: ${cmd[*]}" >"$LOG_FILE"
else
  set +e
  "${cmd[@]}" >"$LOG_FILE" 2>&1
  exit_code=$?
  set -e
fi

if [ "$exit_code" -eq 0 ] && [ "$status" != "dry-run" ]; then
  status="passed"
fi

cat >"$SUMMARY_FILE" <<EOF
# Patrol 验收摘要

- 状态：$status
- 项目：{{PROJECT_NAME}}
- 场景：$PATROL_SCENARIO
- 命令：\`${cmd[*]}\`
- 目标：${PATROL_TARGET:-未指定}
- 设备：${PATROL_DEVICE:-未指定}
- dart define：${PATROL_DART_DEFINE_FILE:-未指定}
- flavor：${PATROL_FLAVOR:-未指定}
- 日志：$LOG_FILE
- 证据：$EVIDENCE_FILE
EOF

python3 - "$EVIDENCE_FILE" "$status" "$exit_code" "$PATROL_SCENARIO" "${cmd[*]}" "${PATROL_TARGET:-}" "${PATROL_DEVICE:-}" "${PATROL_DART_DEFINE_FILE:-}" "${PATROL_FLAVOR:-}" "$LOG_FILE" "$SUMMARY_FILE" <<'PY'
import json
import sys

(
    path,
    status,
    exit_code,
    scenario,
    command,
    target,
    device,
    dart_define_file,
    flavor,
    log_file,
    summary_file,
) = sys.argv[1:]

with open(path, "w", encoding="utf-8") as f:
    json.dump(
        {
            "kind": "patrol",
            "status": status,
            "exit_code": int(exit_code),
            "scenario": scenario,
            "command": command,
            "target": target or None,
            "device": device or None,
            "dart_define_file": dart_define_file or None,
            "flavor": flavor or None,
            "log_file": log_file,
            "summary_file": summary_file,
        },
        f,
        ensure_ascii=False,
        indent=2,
    )
    f.write("\n")
PY

echo "==> Patrol 验收摘要: $SUMMARY_FILE"
echo "==> Patrol 证据: $EVIDENCE_FILE"

if [ "$exit_code" -ne 0 ]; then
  echo "==> Patrol 验收失败，日志尾部:"
  tail -n 120 "$LOG_FILE" || true
fi

exit "$exit_code"
